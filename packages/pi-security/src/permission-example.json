{
  "mode": "auto",
  "classifier": { "model": "openai-codex/gpt-6-luna", "timeoutSec": 15 },
  "deny": [{ "tool": "bash", "match": { "program": "sudo" } }],
  "allow": [
    { "tool": "read" },
    { "tool": "grep" },
    { "tool": "find" },
    { "tool": "ls" },
    { "tool": "bash", "match": { "program": ["pwd", "ls", "rg"] } }
  ]
}
