  "allow": [
    {
      "tool": "bash",
      "match": {
        "program": [
          "echo",
          "printf",
          "true",
          "false",
          ":",
          "uname",
          "whoami",
          "id",
          "pwd",
          "seq",
          "sleep",
          "nproc",
          "arch",
          "uptime",
          "users",
          "who",
          "w",
          "groups",
          "locale",
          "sw_vers",
          "getconf",
          "which",
          "type",
          "tr"
        ]
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": [
          "ls",
          "cat",
          "head",
          "tail",
          "wc",
          "cut",
          "nl",
          "tac",
          "rev",
          "column",
          "fold",
          "paste",
          "comm",
          "diff",
          "cmp",
          "stat",
          "file",
          "du",
          "df",
          "readlink",
          "realpath",
          "dirname",
          "basename",
          "shasum",
          "sha1sum",
          "sha256sum",
          "md5sum",
          "md5",
          "cksum",
          "strings",
          "od",
          "hexdump",
          "expand",
          "unexpand",
          "fmt",
          "base64",
          "base32",
          "base58",
          "ascii85",
          "basenc"
        ],
        "paths": "read"
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": ["pytest", "py.test", "mypy", "pyright"],
        "paths": "read"
      },
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": ["shellcheck"],
        "paths": "read"
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": [
          "lsof",
          "ss",
          "netstat",
          "ioreg",
          "system_profiler",
          "lsmod",
          "kextstat",
          "findmnt",
          "smbstatus",
          "dscacheutil",
          "lsblk",
          "vm_stat",
          "free"
        ]
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "git",
        "subcommand": "status"
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "npm",
        "subcommand": ["test", "t"]
      },
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": ["sh", "bash"],
        "subcommand": "-c"
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "read"
    },
    {
      "tool": "write"
    },
    {
      "tool": "edit"
    },
    {
      "tool": "ls"
    },
    {
      "tool": "find"
    },
    {
      "tool": "grep"
    }
  ]
