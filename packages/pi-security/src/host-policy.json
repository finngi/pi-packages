{
  "version": 2,
  "mode": "manual",
  "resources": {
    "write": ["${project}", "${tmp}"],
    "denyRead": [
      "${agent}/auth.json",
      "${agent}/mcp.json",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/mcp.json",
      "~/.ssh",
      "~/.aws",
      "~/.gnupg",
      "${agent}/mcp-auth.json",
      "${agent}/.env",
      "~/.pi/agent/mcp-auth.json",
      "${project}/.pi/mcp.json",
      "${project}/.pi/mcp-auth.json",
      "~/.codex/auth.json",
      "~/.claude/.credentials.json",
      "~/.claude.credentials.json"
    ],
    "denyWrite": ["${agent}"],
    "network": []
  },
  "classifier": {
    "model": "none",
    "timeoutSec": 5
  },
  "approvalTimeoutSec": 120,
  "env": {
    "path": ["/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"],
    "assignAllow": []
  },
  "deny": [
    {
      "tool": "powershell"
    },
    {
      "tool": "bash",
      "match": {
        "program": ["sudo", "sandbox-exec", "spctl", "csrutil", "diskutil", "visudo", "sudoedit"]
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "security"
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "git",
        "subcommand": "credential"
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "gh",
        "subcommand": "auth",
        "args-contain": "token"
      }
    }
  ],
  "allow": [
    {
      "tool": "codemode",
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "read"
    },
    {
      "tool": "write"
    },
    {
      "tool": "edit"
    },
    {
      "tool": "ls"
    },
    {
      "tool": "find"
    },
    {
      "tool": "grep"
    },
    {
      "tool": "bash",
      "match": {
        "program": [
          "pwd",
          "ls",
          "cat",
          "head",
          "tail",
          "wc",
          "cut",
          "nl",
          "stat",
          "file",
          "du",
          "df",
          "readlink",
          "realpath",
          "dirname",
          "basename",
          "shasum",
          "which",
          "uname",
          "whoami",
          "id",
          "sw_vers",
          "echo",
          "printf",
          "true",
          "false",
          "sleep",
          "rg",
          "grep",
          "fd",
          "find",
          "sed",
          "awk",
          "sort",
          "uniq",
          "tr",
          "diff",
          "cmp"
        ]
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "git",
        "subcommand": [
          "status",
          "diff",
          "log",
          "show",
          "branch",
          "rev-parse",
          "ls-files",
          "ls-tree"
        ]
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": [
          "node",
          "python",
          "python3",
          "pytest",
          "mypy",
          "pyright",
          "tsc",
          "eslint",
          "ruff",
          "gofmt",
          "make",
          "cmake",
          "ninja"
        ]
      },
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "npm",
        "subcommand": ["test", "t", "run", "exec"]
      },
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": "go",
        "subcommand": ["test", "build", "vet", "fmt"]
      },
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "bash",
      "match": {
        "program": ["sh", "bash"],
        "subcommand": "-c"
      },
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "tool_search",
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "background_process",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "subagent",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "subagent_message",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "subagent_check",
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "subagent_cancel",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "subagent_close",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "create_goal",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "get_goal",
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "update_goal",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "wait_for_goal_event",
      "permissions": {
        "write": true,
        "network": []
      }
    },
    {
      "tool": "agent_message",
      "permissions": {
        "write": false,
        "network": []
      }
    },
    {
      "tool": "agent_list",
      "permissions": {
        "write": false,
        "network": []
      }
    }
  ]
}
