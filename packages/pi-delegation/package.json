{
  "name": "pi-delegation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./extensions/subagent.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-ai": "*"
  },
  "scripts": {
    "test": "node --test 'lib/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build.mjs --package pi-delegation"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE*",
    "PROVENANCE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/extensions/subagent.d.ts",
      "default": "./dist/extensions/subagent.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pi-contracts": "0.1.0",
    "pi-runtime": "0.1.0",
    "pi-resource-browser": "0.1.0",
    "proper-lockfile": "4.1.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finngi/pi-packages.git",
    "directory": "packages/pi-delegation"
  },
  "bugs": {
    "url": "https://github.com/finngi/pi-packages/issues"
  },
  "description": "Pi agent discovery, delegation and communication"
}
