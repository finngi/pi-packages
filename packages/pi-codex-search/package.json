{
  "name": "pi-codex-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./extensions/search.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "node security-check.mjs",
    "build": "node ../../scripts/build.mjs --package pi-codex-search"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE*",
    "PROVENANCE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/extensions/search.d.ts",
      "default": "./dist/extensions/search.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pi-contracts": "0.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finngi/pi-packages.git",
    "directory": "packages/pi-codex-search"
  },
  "bugs": {
    "url": "https://github.com/finngi/pi-packages/issues"
  },
  "description": "Codex search integration for Pi"
}
